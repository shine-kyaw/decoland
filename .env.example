# Enquiry form delivery (Resend). Without RESEND_API_KEY the form tells the
# visitor honestly that it is not connected yet (HTTP 503) instead of
# pretending the message was sent.
RESEND_API_KEY=
# Comma-separated recipients. PRD: marketing@decolandgroup.com
ENQUIRY_TO_EMAIL=marketing@decolandgroup.com
# Must be on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=Deco-Land Website <enquiries@decolandgroup.com>

# Public origin used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://decolandgroup.com

# Show the visible [[CLIENT TO SUPPLY]] notes. Leave "true" for client review
# previews; set to "false" for production once the content is supplied.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# CMS database backups (docs/BACKUP.md). Nightly via Vercel Cron to a PRIVATE
# Vercel Blob store; BLOB_READ_WRITE_TOKEN is set when the store is connected.
BACKUP_KEY=
CRON_SECRET=
